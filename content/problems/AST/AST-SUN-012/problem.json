 "statement": {
  "blocks": [
   {
    "type": "text",
    "tex": "黒点の温度を 4000 K、まわりの光球を 5800 K とする。黒点の単位面積あたりの放射エネルギーは、まわりの何倍か（有効数字2桁）。"
   }
  ]
 },
 "figures": [],
 "answer": {
  "parts": [
   {
    "id": "main",
    "tex": "約 0.23 倍",
    "grading": "約{0.23|2} [倍]"
   }
  ]
 },
 "solutions": [
  {
   "id": "main",
   "kind": "main",
   "blocks": [
    {
     "type": "text",
     "tex": "シュテファン・ボルツマンの法則 $E=\\sigma T^4$ より $\\left(\\dfrac{4000}{5800}\\right)^4\\fallingdotseq0.23$。黒点も 4000 K の高温で強く光っているが、まわりが約 4 倍明るいので、比べると黒く見える。"
    }
   ]
  }
 ],
