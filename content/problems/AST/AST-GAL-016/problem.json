 ],
 "examStyle": "original",
 "statement": {
  "blocks": [
   {
    "type": "text",
    "tex": "実際の大きさと明るさが同じ2つの銀河 A、B の後退速度を測ったところ、A は 4000 km/s、B は 12000 km/s だった。ハッブル・ルメートルの法則が成り立つとする。"
   },
   {
    "type": "parts",
    "items": [
     {
      "id": "1",
      "tex": "B までの距離は A の何倍か。"
     },
     {
      "id": "2",
      "tex": "B の見かけの明るさは A の何倍か。"
     },
     {
      "id": "3",
      "tex": "B の見かけの大きさ（直径の角度）は A の何倍か。"
     }
    ]
   }
  ]
 },
 "figures": [],
 "answer": {
  "parts": [
   {
    "id": "1",
    "tex": "3 倍",
    "grading": "約{3|1} [倍]"
   },
   {
    "id": "2",
    "tex": "1/9 倍",
    "grading": "約{0.111|2} [倍]"
   },
   {
    "id": "3",
    "tex": "1/3 倍",
    "grading": "約{0.333|2} [倍]"
   }
  ]
 },
 "solutions": [
  {
   "id": "main",
   "kind": "main",
   "blocks": [
    {
     "type": "text",
     "tex": "(1) 後退速度は距離に比例するので B は 3 倍遠い。(2) 明るさは距離の2乗に反比例して $\\dfrac19$。(3) 見かけの大きさ（角度）は距離に反比例して $\\dfrac13$。"
    }
   ]
  }
 ],
