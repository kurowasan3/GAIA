 "statement": {
  "blocks": [
   {
    "type": "text",
    "tex": "ある海嶺の軸から 39 km 離れた所で、今から 78 万年前の地磁気の逆転の境界が見つかった。海嶺の片側の海洋底が広がる速さを cm/年 で求めよ（有効数字2桁）。"
   }
  ]
 },
 "figures": [],
 "answer": {
  "parts": [
   {
    "id": "main",
    "tex": "5.0 cm/年",
    "grading": "約{5.0|2} [cm/年]"
   }
  ]
 },
 "solutions": [
  {
   "id": "main",
   "kind": "main",
   "blocks": [
    {
     "type": "text",
     "tex": "$\\dfrac{39\\ \\mathrm{km}}{7.8\\times10^{5}\\ \\text{年}}=\\dfrac{3.9\\times10^{6}\\ \\mathrm{cm}}{7.8\\times10^{5}\\ \\text{年}}=5.0$ cm/年。両側を合わせた拡大速度は 10 cm/年。"
    }
   ]
  }
 ],
