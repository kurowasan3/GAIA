 "statement": {
  "blocks": [
   {
    "type": "text",
    "tex": "SiO₄ 四面体が平面状（シート状）につながった構造をもち、うすくはがれる性質（へき開）をもつ鉱物はどれか。"
   }
  ]
 },
 "figures": [],
 "answer": {
  "parts": [
   {
    "id": "main",
    "tex": "黒雲母",
    "grading": "選ぶ{黒雲母|かんらん石|輝石|石英}=1"
   }
  ]
 },
 "solutions": [
  {
   "id": "main",
   "kind": "main",
   "blocks": [
    {
     "type": "text",
     "tex": "雲母のなかまは SiO₄ 四面体が層状につながり、層の間の結合が弱いのでうすくはがれる。かんらん石は独立、輝石は単鎖、角閃石は複鎖、石英・長石は立体網目構造。"
    }
   ]
  }
 ],
