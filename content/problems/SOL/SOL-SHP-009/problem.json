 "statement": {
  "blocks": [
   {
    "type": "text",
    "tex": "自転による遠心力の大きさは、自転軸からの距離に比例する。地球を球として、北緯 $60^\\circ$ の地点での遠心力は、赤道での遠心力の何倍か。"
   }
  ]
 },
 "figures": [],
 "answer": {
  "parts": [
   {
    "id": "main",
    "tex": "$0.5$ 倍",
    "grading": "約{0.50|2} [倍]"
   }
  ]
 },
 "solutions": [
  {
   "id": "main",
   "kind": "main",
   "blocks": [
    {
     "type": "text",
     "tex": "北緯 $\\varphi$ の地点の自転軸からの距離は $R\\cos\\varphi$。$\\cos60^\\circ=0.5$ なので 0.5 倍。"
    }
   ]
  }
 ],
