    "tex": "$1.0\\times10^{2}$ km",
    "grading": "約{1.0e2|2} [km]"
   }
  ]
 },
 "solutions": [
  {
   "id": "main",
   "kind": "main",
   "blocks": [
    {
     "type": "text",
     "tex": "震源距離 $D$ の点では $T=\\dfrac{D}{3.5}-\\dfrac{D}{6.0}$。$D=\\dfrac{6.0\\times3.5}{6.0-3.5}T=8.4\\times12\\fallingdotseq1.0\\times10^{2}$ km。"
    }
   ]
  }
 ],
