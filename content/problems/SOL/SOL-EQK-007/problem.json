   {
    "type": "text",
    "tex": "マグニチュード 8.0 の地震のエネルギーは、マグニチュード 6.0 の地震のエネルギーの何倍か。"
   }
  ]
 },
 "figures": [],
 "answer": {
  "parts": [
   {
    "id": "main",
    "tex": "1000 倍",
    "grading": "約{1.0e3|2} [倍]"
   }
  ]
 },
 "solutions": [
  {
   "id": "main",
   "kind": "main",
   "blocks": [
    {
     "type": "text",
     "tex": "$\\dfrac{E_8}{E_6}=10^{1.5\\times(8.0-6.0)}=10^{3}=1000$ 倍。"
    }
   ]
  }
