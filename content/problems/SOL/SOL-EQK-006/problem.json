   "blocks": [
    {
     "type": "text",
     "tex": "$\\log_{10}E=4.8+1.5M$ より、M が 1 増えると E は $10^{1.5}\\fallingdotseq32$ 倍。2 増えると $10^{3}=1000$ 倍。"
    }
   ]
  }
