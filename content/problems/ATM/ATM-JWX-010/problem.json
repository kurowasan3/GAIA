 "solutions": [
  {
   "id": "main",
   "kind": "main",
   "blocks": [
    {
     "type": "text",
     "tex": "台風の風は反時計回り。進行方向の右側では、台風の風の向きと台風の移動の向きが同じになるので風が強くなる（危険半円）。"
    }
   ]
  }
 ],
