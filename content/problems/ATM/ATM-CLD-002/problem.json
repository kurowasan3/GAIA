 "statement": {
  "blocks": [
   {
    "type": "text",
    "tex": "水蒸気が飽和していない空気塊が上昇するとき、温度はおよそどのような割合で下がるか。"
   }
  ]
 },
 "figures": [],
 "answer": {
  "parts": [
   {
    "id": "main",
    "tex": "100 m につき約 1 ℃",
    "grading": "選ぶ{100 m につき約 1 ℃|100 m につき約 0.5 ℃|100 m につき約 0.1 ℃|100 m につき約 6 ℃}=1"
   }
  ]
 },
 "solutions": [
  {
   "id": "main",
   "kind": "main",
   "blocks": [
    {
     "type": "text",
     "tex": "上昇した空気は膨張して外に仕事をし、温度が下がる（断熱膨張）。飽和していなければ約 1 ℃/100 m（乾燥断熱減率）。"
    }
   ]
  }
 ],
