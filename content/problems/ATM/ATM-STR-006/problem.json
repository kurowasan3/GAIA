 "statement": {
  "blocks": [
   {
    "type": "text",
    "tex": "気圧は高さ約 5.5 km ごとにほぼ半分になる。地表の気圧を 1000 hPa とすると、高さ 11 km（対流圏の上端付近）の気圧はおよそ何 hPa か。"
   }
  ]
 },
 "figures": [],
 "answer": {
  "parts": [
   {
    "id": "main",
    "tex": "約 250 hPa",
    "grading": "約{2.5e2|2} [hPa]"
   }
  ]
 },
 "solutions": [
  {
   "id": "main",
   "kind": "main",
   "blocks": [
    {
     "type": "text",
     "tex": "5.5 km で 500 hPa、11 km でその半分の 250 hPa。大気の質量の約 4 分の 3 は対流圏にある。"
    }
   ]
  }
 ],
