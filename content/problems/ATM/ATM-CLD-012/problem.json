 "statement": {
  "blocks": [
   {
    "type": "text",
    "tex": "次のうち、風下で気温が上がる（フェーン現象が起こる）のはどの場合か。"
   }
  ]
 },
 "figures": [],
 "answer": {
  "parts": [
   {
    "id": "main",
    "tex": "風上側の斜面で雲ができて雨が降った場合",
    "grading": "選ぶ{風上側の斜面で雲ができて雨が降った場合|風上側で雲ができなかった場合|風下側の斜面で雲ができた場合|風が山を越えればいつでも}=1"
   }
  ]
 },
 "solutions": [
  {
   "id": "main",
   "kind": "main",
   "blocks": [
    {
     "type": "text",
     "tex": "風上で雲ができなければ、上りも下りも乾燥断熱減率なので、ふもとの気温は変わらない。雲ができて雨を降らせた（水分を失った）ときに、潜熱の分だけ風下が高温・乾燥になる。"
    }
   ]
  }
 ],
