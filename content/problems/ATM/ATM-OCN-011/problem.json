 "solutions": [
  {
   "id": "main",
   "kind": "main",
   "blocks": [
    {
     "type": "text",
     "tex": "月が南中してから次に南中するまでは約 24 時間 50 分。満潮は1日に2回なので、満潮の間隔は約 12 時間 25 分。(1) $6:00+12:25=18:25$。(2) $6:00+24:50=$ 翌日の 6:50。潮の満ち引きは毎日約 50 分ずつおそくなる。"
    }
   ]
  }
 ],
